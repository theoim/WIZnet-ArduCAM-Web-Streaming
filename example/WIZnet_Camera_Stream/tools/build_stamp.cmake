# Build stamp, run on every build (cmake -P, see the camera_build_stamp target).
#
#   cmake -DSRC=<example dir> -DOUT=<build dir>/cam_build_stamp.c -P build_stamp.cmake
#
# The id is the commit, plus a short hash of this example's uncommitted
# changes when there are any:
#
#   0f285d6           clean
#   0f285d6+3fa9c1    this directory differs from the commit
#
# Only this directory counts. "git describe --dirty" looks at the whole
# repository, so unrelated work elsewhere marked every image dirty, and two
# different camera images (the old and new PIO, 2026-10-28) reported the same
# "0f285d6-dirty". The hash covers tracked changes and the names of untracked,
# not-ignored files.
#
# Running at build time rather than configure time means the id follows the
# sources without re-running cmake. The UTC time changes on every build, so
# the one small file it lands in is recompiled and the image relinked.

execute_process(COMMAND git rev-parse --short=7 HEAD
        WORKING_DIRECTORY ${SRC} OUTPUT_VARIABLE head
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR head STREQUAL "")
    set(id "no-git")
else()
    execute_process(COMMAND git diff HEAD -- .
            WORKING_DIRECTORY ${SRC} OUTPUT_VARIABLE diff ERROR_QUIET)
    execute_process(COMMAND git ls-files --others --exclude-standard -- .
            WORKING_DIRECTORY ${SRC} OUTPUT_VARIABLE untracked ERROR_QUIET)
    # Line endings follow the checkout; hash them out so the id does not.
    string(REPLACE "\r" "" changes "${diff}${untracked}")
    if(changes STREQUAL "")
        set(id "${head}")
    else()
        string(SHA1 sum "${changes}")
        string(SUBSTRING "${sum}" 0 6 sum)
        set(id "${head}+${sum}")
    endif()
endif()
string(TIMESTAMP utc "%Y-%m-%dT%H:%M:%SZ" UTC)

file(WRITE ${OUT}
        "/* Generated by tools/build_stamp.cmake on every build - do not edit. */\n"
        "const char cam_build_id[] = \"${id}\";\n"
        "const char cam_build_utc[] = \"${utc}\";\n")
