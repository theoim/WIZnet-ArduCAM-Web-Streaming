/**
 * @file    secrets.h.example
 * @brief   Template for secrets.h, which is not committed.
 *
 * Copy this file to secrets.h in the same directory and fill it in. config.h
 * includes secrets.h when it exists and falls back to placeholders when it does
 * not, so a fresh checkout builds and tells you what is missing instead of
 * failing to compile.
 *
 * secrets.h is in .gitignore. Keep it that way: a webhook URL is a password for
 * a Discord channel and the stream token is the only thing between the camera
 * and whoever finds the forwarded port. Once either reaches a repository, a log
 * file or a screen share, the only real fix is to issue a new one.
 */

#ifndef __SECRETS_H__
#define __SECRETS_H__

/*
 * Discord webhook. Server Settings -> Integrations -> Webhooks -> Copy URL.
 *
 * Leave this out entirely and the box still watches, still serves the panel and
 * still logs alarms - it just cannot send them anywhere. It can also be entered
 * from the CONFIG tab at any time, which is the better route for a box that is
 * already installed.
 */
#define WEBHOOK_URL \
    "https://discord.com/api/webhooks/000000000000000000/xxxxxxxxxxxxxxxxxxxxxx"

/*
 * The token that gates every path on the web server.
 *
 * Long and random. A request without it gets 404 rather than 401, so a scanner
 * cannot even learn that the path exists. Thirty-two characters from an
 * alphabet of letters, digits, - and _ is plenty:
 *
 *   python -c "import secrets;print(secrets.token_urlsafe(24))"
 */
#define STREAM_TOKEN        "CHANGEME"

/*
 * How a phone reaches this board from outside, including the port the router
 * forwards. The board only ever sees its own private address, so it has to be
 * told; this is what makes the link in the Discord message tappable.
 *
 * Example: "http://222.111.22.33:8080"
 */
#define PUBLIC_URL_BASE     "http://CHANGEME:8080"

#endif /* __SECRETS_H__ */
